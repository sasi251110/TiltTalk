name: TiltTalk Android Build

on:
  push:
    branches: [main, master]
  pull_request:
    branches: [main, master]
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: tilttalk-android-${{ github.ref }}
  cancel-in-progress: true

jobs:
  build:
    name: Build and Test TiltTalk
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Set up Gradle
        uses: gradle/actions/setup-gradle@v4

      - name: Set up Android SDK
        uses: android-actions/setup-android@v3

      - name: Verify project files
        run: |
          if [ ! -f "./gradlew" ]; then
            echo "ERROR: Gradle wrapper not found."
            echo "Upload a complete Android Studio project."
            exit 1
          fi

          if [ ! -f "./settings.gradle.kts" ] && \
             [ ! -f "./settings.gradle" ]; then
            echo "ERROR: Gradle settings file not found."
            exit 1
          fi

          if [ ! -f "./app/build.gradle.kts" ] && \
             [ ! -f "./app/build.gradle" ]; then
            echo "ERROR: Android app module not found."
            exit 1
          fi

          chmod +x ./gradlew

      - name: Build debug APK
        run: ./gradlew assembleDebug

      - name: Run unit tests
        run: ./gradlew testDebugUnitTest

      - name: Upload TiltTalk APK
        uses: actions/upload-artifact@v4
        with:
          name: TiltTalk-Android-APK
          path: app/build/outputs/apk/debug/*.apk
          if-no-files-found: error
          retention-days: 14

      - name: Report build success
        if: success()
        run: echo "TiltTalk APK built and uploaded successfully."
